{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "drone-cloud-sync",
  "version": "0.1.0",
  "identifier": "app.drone-cloud-sync.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "drone-cloud-sync",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Cloud flight logs, safely in your folder",
    "copyright": "Copyright \u00a9 2026 drone-cloud-sync contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "languages": ["English"]
      },
      "wix": {
        "language": "en-US"
      }
    },
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
